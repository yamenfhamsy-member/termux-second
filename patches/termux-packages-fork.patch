@@ -116,7 +116,59 @@ extract_debs() {
 		echo "\""
 	fi
 
-	for deb in *.deb; do
+	# Compute exact runtime Depends closure of PACKAGES so build-only debs (docbook-xsl, libdb, brotli, etc.) are excluded
+	local allowed_debs
+	allowed_debs="$(python3 - "$package_arch" "${PACKAGES[@]}" <<-'PYEOF'
+	import os, re, subprocess, sys
+	target_arch = sys.argv[1]
+	roots = sys.argv[2:]
+	pkg_to_deb = {}
+	pkg_deps = {}
+	provides_to_pkg = {}
+	for fn in sorted(os.listdir(".")):
+	    if not fn.endswith(".deb"):
+	        continue
+	    m = re.search(r"_(aarch64|all|arm|i686|x86_64)\.deb$", fn)
+	    if not m or m.group(1) not in (target_arch, "all"):
+	        continue
+	    ctrl = subprocess.check_output(["dpkg-deb", "-f", fn], text=True)
+	    pname = ""
+	    deps = []
+	    for line in ctrl.splitlines():
+	        if line.startswith("Package:"):
+	            pname = line.split(":", 1)[1].strip()
+	        elif line.startswith("Depends:"):
+	            raw = re.sub(r"\(.*?\)", "", line.split(":", 1)[1])
+	            for tok in raw.split(","):
+	                d = tok.strip().split("|")[0].strip()
+	                if d:
+	                    deps.append(d)
+	        elif line.startswith("Provides:"):
+	            raw = re.sub(r"\(.*?\)", "", line.split(":", 1)[1])
+	            for tok in raw.split(","):
+	                v = tok.strip()
+	                if v and pname:
+	                    provides_to_pkg.setdefault(v, pname)
+	    if pname and not pname.endswith("-static"):
+	        pkg_to_deb[pname] = fn
+	        pkg_deps[pname] = deps
+	needed = []
+	seen = set()
+	def visit(p):
+	    p = provides_to_pkg.get(p, p)
+	    if p in seen or p not in pkg_to_deb:
+	        return
+	    seen.add(p)
+	    for d in pkg_deps.get(p, []):
+	        visit(d)
+	    needed.append(pkg_to_deb[p])
+	for r in roots:
+	    visit(r)
+	print("\n".join(needed))
+	PYEOF
+	)"
+
+	for deb in $allowed_debs; do
 
 		current_package_name="$(echo "$deb" | sed -E 's/^([^_]+).*/\1/' )"
 		current_package_arch="$(echo "$deb" | sed -E 's/.*_(aarch64|all|arm|i686|x86_64).deb$/\1/' )"
@@ -246,7 +298,8 @@ create_bootstrap_archive() {
 		zip -r9 "${BOOTSTRAP_TMPDIR}/bootstrap-${1}.zip" ./*
 	)
 
-	mv -f "${BOOTSTRAP_TMPDIR}/bootstrap-${1}.zip" "$TERMUX_PACKAGES_DIRECTORY/"
+	mkdir -p "$TERMUX_BUILT_DEBS_DIRECTORY"
+	mv -f "${BOOTSTRAP_TMPDIR}/bootstrap-${1}.zip" "$TERMUX_BUILT_DEBS_DIRECTORY/bootstrap-${1}.zip"
 
 	echo "[*] Finished successfully (${1})."
 
@@ -436,6 +489,7 @@ main() {
